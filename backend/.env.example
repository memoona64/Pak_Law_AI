# Port number for Express server to listen on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas cluster).
# If you get "querySrv ETIMEOUT ..." here, your network is blocking the DNS
# SRV lookup that Atlas's usual mongodb+srv:// URI needs, even though
# config/db.js's DNS-override workaround didn't fix it. Switch to the
# standard (non-SRV) connection string instead — get it from Atlas's
# "Connect" dialog by choosing the driver version option that shows
# mongodb://host1,host2,host3/... rather than mongodb+srv://cluster/..., or
# derive it yourself: `nslookup -type=SRV _mongodb._tcp.<cluster>.mongodb.net 8.8.8.8`
# for the three shard hosts, and `nslookup -type=TXT <cluster>.mongodb.net 8.8.8.8`
# for the replicaSet/authSource options.
MONGO_URI=******

# Secret key used for signing JWT tokens for authentication
JWT_SECRET=*******

# Base URL for internal Python FastAPI retrieval service (Express calls internally)
PYTHON_SERVICE_URL=*****

# Toggle flag: 'true' uses internal mock services; 'false' forwards calls to Python FastAPI
USE_MOCK=false

# Allowed origin for Cross-Origin Resource Sharing (React Frontend)
CORS_ORIGIN=http:*****

# Optional: if both are set, the server auto-creates/promotes this account
# to role: 'admin' on every startup (see bootstrapAdmin.js). Unset both to
# turn this off — there is no default/built-in admin otherwise.
ADMIN_EMAIL=*****
ADMIN_PASSWORD=*****